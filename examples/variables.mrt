// variables.mrt
var yas = 22
var oran = 3.14
var isim = "Murat"
var aktif = yes
var bos = none

say "İsim: " + isim
say "Yaş: " + toText(yas)
say "Oran: " + toText(oran)
say "Aktif: " + toText(aktif)
say "Boş: " + toText(bos)

say "typeOf(yas): " + typeOf(yas)
say "typeOf(oran): " + typeOf(oran)
say "typeOf(isim): " + typeOf(isim)
say "typeOf(aktif): " + typeOf(aktif)
say "typeOf(bos): " + typeOf(bos)
