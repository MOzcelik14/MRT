<?xml version="1.0" encoding="UTF-8"?>
<language id="mrt" name="MRT" version="2.0" _section="Source">
  <metadata>
    <property name="mimetypes">text/x-mrt</property>
    <property name="globs">*.mrt</property>
    <property name="line-comment-start">//</property>
  </metadata>

  <styles>
    <style id="comment" name="Comment" map-to="def:comment"/>
    <style id="string" name="String" map-to="def:string"/>
    <style id="keyword" name="Keyword" map-to="def:keyword"/>
    <style id="builtin" name="Builtin" map-to="def:builtin"/>
    <style id="boolean" name="Boolean" map-to="def:boolean"/>
    <style id="null" name="Null" map-to="def:special-constant"/>
    <style id="decimal" name="Decimal" map-to="def:decimal"/>
    <style id="floating-point" name="Floating Point" map-to="def:floating-point"/>
    <style id="operator" name="Operator" map-to="def:operator"/>
    <style id="function-name" name="Function Name" map-to="def:function"/>
  </styles>

  <definitions>
    <context id="line-comment" style-ref="comment" end-at-line-end="true" class="comment" class-disabled="no-spell-check">
      <start>//</start>
      <include>
        <context ref="def:in-line-comment"/>
      </include>
    </context>

    <context id="string" style-ref="string" end-at-line-end="true" class="string" class-disabled="no-spell-check">
      <start>"</start>
      <end>"</end>
      <include>
        <context ref="def:escape"/>
        <context ref="def:line-continue"/>
      </include>
    </context>

    <context id="keywords" style-ref="keyword">
      <keyword>let</keyword>
      <keyword>fn</keyword>
      <keyword>if</keyword>
      <keyword>else</keyword>
      <keyword>while</keyword>
      <keyword>return</keyword>
      <keyword>and</keyword>
      <keyword>or</keyword>
      <keyword>not</keyword>
    </context>

    <context id="boolean" style-ref="boolean">
      <keyword>true</keyword>
      <keyword>false</keyword>
    </context>

    <context id="null" style-ref="null">
      <keyword>null</keyword>
    </context>

    <context id="builtins" style-ref="builtin">
      <keyword>print</keyword>
      <keyword>typeof</keyword>
      <keyword>len</keyword>
      <keyword>str</keyword>
      <keyword>clock</keyword>
    </context>

    <context id="function-declaration">
      <match>\bfn\s+([a-zA-Z_][a-zA-Z0-9_]*)</match>
      <include>
        <context sub-pattern="1" style-ref="function-name"/>
      </include>
    </context>

    <context id="float" style-ref="floating-point">
      <match>\b[0-9]+\.[0-9]+\b</match>
    </context>

    <context id="decimal" style-ref="decimal">
      <match>\b[0-9]+\b</match>
    </context>

    <context id="operators" style-ref="operator">
      <match>(\+|\-|\*|\/|\%|==|!=|&lt;=|&gt;=|&lt;|&gt;|=)</match>
    </context>

    <context id="mrt" class="no-spell-check">
      <include>
        <context ref="line-comment"/>
        <context ref="string"/>
        <context ref="function-declaration"/>
        <context ref="keywords"/>
        <context ref="boolean"/>
        <context ref="null"/>
        <context ref="builtins"/>
        <context ref="float"/>
        <context ref="decimal"/>
        <context ref="operators"/>
      </include>
    </context>
  </definitions>
</language>
